---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Mission from '../components/Mission.astro';
import Programs from '../components/Programs.astro';
import Empowerment from '../components/Empowerment.astro';
import Leadership from '../components/Leadership.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import Dialogs from '../components/Dialogs.astro';
---

<BaseLayout>
  <Navigation />
  <main id="main">
    <Hero />
    <Mission />
    <Programs />
    <Empowerment />
    <Leadership />
    <ClosingCTA />
    <Contact />
  </main>
  <Footer />
  <Dialogs />
</BaseLayout>
