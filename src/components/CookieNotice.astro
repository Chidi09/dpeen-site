<aside
  class="cookie-notice"
  role="region"
  aria-labelledby="cookie-notice-title"
  hidden
>
  <div class="cookie-notice-copy">
    <p id="cookie-notice-title" class="cookie-notice-title">
      Your privacy
    </p>
    <p>
      We don’t use advertising or analytics cookies. This site only stores what
      it needs to work, such as this choice and pages saved for faster loading.{' '}
      <a href="/cookies/">Cookie policy</a>
    </p>
  </div>
  <button type="button" class="button button-dark" data-cookie-dismiss>
    Got it
  </button>
</aside>
