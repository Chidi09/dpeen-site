---
import { opportunities, scholarship } from '../data/programs';
---

<section id="empowerment" class="empowerment-editorial">
  <div class="container">
    <div class="opportunity-heading">
      <div>
        <p class="section-label">03 / Skills &amp; opportunity</p>
        <h2 class="display-heading">
          Poverty <em>eradication.</em>
        </h2>
        <p class="opportunity-intro">
          Reliable income through verified skills.
        </p>
      </div>
      <button class="button opportunity-button" data-enquiry="Partner as a Hub">
        Partner with us <span aria-hidden="true">↗</span>
      </button>
    </div>
    <div class="opportunity-grid">
      {opportunities.map((opportunity) => (
        <article class="opportunity-card">
          <img
            src={`https://images.unsplash.com/${opportunity.image}?q=80&w=900&auto=format&fit=crop`}
            alt={opportunity.alt}
            loading="lazy"
            width="600"
            height="400"
          />
          <h3>{opportunity.title}</h3>
          <p>{opportunity.description}</p>
        </article>
      ))}
    </div>
    <div class="scholarship-row">
      <span class="scholarship-label">Continuing education</span>
      <div>
        <h3>{scholarship.title}</h3>
        <p>{scholarship.description}</p>
      </div>
    </div>
  </div>
</section>
