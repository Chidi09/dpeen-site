---
import EnquiryForm from './EnquiryForm.astro';
---

<section id="contact" class="contact-editorial">
  <div class="container contact-grid">
    <div>
      <p class="section-label">05 / Start a conversation</p>
      <h2 class="display-heading">
        Good change starts
        <br />
        with a conversation.
      </h2>
      <p class="contact-intro">
        A question, an idea, or a hand to lend. We’d love to hear from you.
      </p>
      <a class="contact-email" href="mailto:info@dpeenetwork.com">
        info@dpeenetwork.com ↗
      </a>
    </div>
    <div class="contact-panel">
      <h3>Write to DPEEN</h3>
      <EnquiryForm prefix="contact" />
    </div>
  </div>
</section>
