---
import PaintedHands from './PaintedHands.astro';
---

<section id="mission" class="mission-editorial">
  <div class="container">
    <div class="editorial-heading">
      <p class="section-label">01 / Our mission</p>
      <span class="editorial-aside">People first. Always.</span>
    </div>
    <div class="mission-layout">
      <div class="mission-statement">
        <h2 class="display-heading">
          Transforming lives.
          <br />
          <em>And communities.</em>
        </h2>
        <p>
          Transforming lives and communities by preventing drug use, treating
          addiction, and promoting recovery through collaborative partnerships.
        </p>
        <a href="#program" class="text-link">
          Explore our approach <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="mission-principles">
        <PaintedHands class="principles-mark" />
        <ul>
          <li>
            <span>01</span>Preventing drug use
          </li>
          <li>
            <span>02</span>Treating addiction
          </li>
          <li>
            <span>03</span>Promoting recovery
          </li>
          <li>
            <span>04</span>Collaborative partnerships
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
