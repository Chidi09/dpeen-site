---
const { prefix, interest = 'General enquiry' } = Astro.props;
const options = [
  'General enquiry',
  'Partner as a Hub',
  'Volunteer (Rehabilitation)',
  'Request Help',
];
---

<form
  data-enquiry-form
  class="enquiry-form"
  method="post"
  action="/api/contact"
>
  <div class="enquiry-identity">
    <div>
      <label for={`${prefix}-name`}>Full name</label>
      <input
        id={`${prefix}-name`}
        name="fullName"
        autocomplete="name"
        required
        placeholder="Your full name"
        minlength="2"
        maxlength="120"
      />
    </div>
    <div>
      <label for={`${prefix}-email`}>Email address</label>
      <input
        id={`${prefix}-email`}
        name="email"
        type="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
        maxlength="254"
      />
    </div>
  </div>
  <div>
    <label for={`${prefix}-interest`}>I want to…</label>
    <select id={`${prefix}-interest`} name="interest">
      {options.map((option) => (
        <option selected={option === interest}>{option}</option>
      ))}
    </select>
  </div>
  <div>
    <label for={`${prefix}-message`}>Message (optional)</label>
    <textarea
      id={`${prefix}-message`}
      name="message"
      rows="4"
      maxlength="2000"
      placeholder="Tell us a little about your enquiry."
    ></textarea>
  </div>
  <div hidden aria-hidden="true">
    <label for={`${prefix}-website`}>Website</label>
    <input
      id={`${prefix}-website`}
      name="website"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <button type="submit" class="button button-red enquiry-submit">
    <span>Send message</span>
    <span aria-hidden="true">↗</span>
  </button>
  <p class="text-sm leading-relaxed" role="status" aria-live="polite"></p>
  <noscript>
    Please email <a href="mailto:info@dpeenetwork.com">info@dpeenetwork.com</a>{' '}
    to contact us.
  </noscript>
</form>
