---
import { Image } from 'astro:assets';
import handprints from '../../public/images/illustrations/painted-handprints.png';
const { class: className = '' } = Astro.props;
const sizes =
  className === 'note-symbol'
    ? '(max-width: 767px) 38px, (max-width: 1023px) 52px, 72px'
    : className === 'principles-mark'
      ? '116px'
      : '(max-width: 767px) 185px, 320px';
---

<span class:list={['painted-hands', className]} aria-hidden="true">
  <Image
    src={handprints}
    alt=""
    width={480}
    widths={[96, 240, 480]}
    sizes={sizes}
    format="webp"
    quality={85}
    loading="lazy"
  />
</span>
