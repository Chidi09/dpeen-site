---
import PaintedHands from './PaintedHands.astro';
---

<section class="closing-editorial" aria-labelledby="get-involved-heading">
  <div class="container closing-layout">
    <div>
      <p class="section-label">Be part of the change</p>
      <h2 id="get-involved-heading" class="display-heading">
        A healthier future.
        <br />
        <em>With you in it.</em>
      </h2>
    </div>
    <div class="closing-actions">
      <button class="button button-dark" data-donate>
        Support our work <span aria-hidden="true">↗</span>
      </button>
      <button class="text-link" data-enquiry="Volunteer (Rehabilitation)">
        Volunteer with us <span aria-hidden="true">↗</span>
      </button>
      <button class="text-link" data-enquiry="Partner as a Hub">
        Partner with DPEEN <span aria-hidden="true">↗</span>
      </button>
    </div>
    <PaintedHands class="closing-mark" />
  </div>
</section>
