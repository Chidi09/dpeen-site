---
import PaintedHands from './PaintedHands.astro';
---

<section class="campaign-hero" aria-labelledby="campaign-title">
  <div class="container">
    <div class="campaign-intro">
      <p class="campaign-eyebrow">
        <span aria-hidden="true"></span> Prevention. Recovery. Possibility.
      </p>
      <h1 id="campaign-title" class="campaign-title">
        SAY <em>NO</em>
        <br />
        TO DRUGS
      </h1>
      <p class="campaign-description">
        Helping young people and communities build healthier futures through
        education, recovery support and practical skills.
      </p>
      <div class="campaign-actions">
        <button
          class="button button-red"
          data-enquiry="Volunteer (Rehabilitation)"
        >
          Join the network <span aria-hidden="true">↗</span>
        </button>
        <a class="button button-outline" href="#mission">
          Learn more
        </a>
      </div>
    </div>
    <div class="campaign-composition">
      <div class="campaign-orbit" aria-hidden="true"></div>
      <figure class="campaign-main-photo">
        <img
          src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?q=80&w=1400&auto=format&fit=crop"
          alt="Young people spending time together outdoors"
          width="700"
          height="800"
          fetchpriority="high"
        />
        <figcaption>
          A healthier future
          <br />
          <em>starts with community.</em>
        </figcaption>
      </figure>
      <figure class="campaign-side-photo campaign-photo-left">
        <img
          src="https://images.unsplash.com/photo-1531206715517-5c0ba140b2b8?q=80&w=600&auto=format&fit=crop"
          alt="Community members joining hands"
          width="300"
          height="360"
        />
        <figcaption>Stronger, together.</figcaption>
      </figure>
      <figure class="campaign-side-photo campaign-photo-right">
        <img
          src="https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=600&auto=format&fit=crop"
          alt="Young people learning digital skills together"
          width="300"
          height="360"
        />
        <figcaption>Skills for tomorrow.</figcaption>
      </figure>
      <div class="campaign-note note-prevention">
        <PaintedHands class="note-symbol" />
        <div>
          <span class="note-kicker">Where change begins</span>
          <strong>
            Education &amp;
            <br />
            prevention
          </strong>
        </div>
      </div>
      <div class="campaign-note note-recovery">
        <span class="note-kicker">A way forward</span>
        <strong>
          Recovery.
          <br />
          <em>Then possibility.</em>
        </strong>
        <span class="note-arrow" aria-hidden="true">
          ↗
        </span>
      </div>
      <span class="campaign-seal" aria-hidden="true">
        A FUTURE
        <br />
        WORTH
        <br />
        <em>choosing.</em>
      </span>
    </div>
    <div class="campaign-foundation">
      <p>
        Drug Prevention Education
        <br />
        and Empowerment Network
      </p>
      <span>Education</span>
      <span>Rehabilitation</span>
      <span>Recreation</span>
      <span>Empowerment</span>
    </div>
  </div>
</section>
